# Entity: season

main: kit: entity: season: {

  alias: field: {}

  fields: [
    {
      name: "endDate"
      req: false
      short: "End date"
      type: "`$STRING`"
    }
    {
      name: "episodeOrder"
      req: false
      short: "Number of episodes"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique season identifier"
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "links"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      short: "Season name"
      type: "`$STRING`"
    }
    {
      name: "network"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "number"
      req: false
      short: "Season number"
      type: "`$INTEGER`"
    }
    {
      name: "premiereDate"
      req: false
      short: "Premiere date"
      type: "`$STRING`"
    }
    {
      name: "summary"
      req: false
      short: "HTML summary"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "TVmaze URL for the season"
      type: "`$STRING`"
    }
    {
      name: "webChannel"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "season"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "show_id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/shows/{id}/seasons"
          parts: [
            "shows"
            "{show_id}"
            "seasons"
          ]
          rename: {
            param: {
              id: "show_id"
            }
          }
          select: {
            exist: [
              "show_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "show"
      ]
    ]
  }



}
